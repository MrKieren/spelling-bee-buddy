# Copy to .env (optional; these are the defaults).

# Host port for the public page.
PUBLIC_PORT=8090

# Port for the admin page, http://localhost:<port> (this machine only).
ADMIN_PORT=8091

# Minimum seconds between NYT fetches, however many people load the page.
MIN_SYNC_INTERVAL=5

# Background refresh even when nobody has the page open (0 = only on visits).
BACKGROUND_SYNC_MINUTES=60

# 1 = save every request Buddy makes, the Buddy page and screenshots to ./debug
# on each sync (for troubleshooting; the files contain puzzle answers).
DEBUG_CAPTURE=0

# 1 = use built-in fake puzzle data instead of NYT (for trying the stack).
FAKE_NYT=0

# Restart the collector's browser this often (hours), to keep its memory in check.
BROWSER_RESTART_HOURS=6

# 1 = include the "You vs. other Bee Buddy visitors" section. The collector reads
# it from Buddy whenever your found words change, or after VISITOR_STATS_MINUTES.
VISITOR_STATS=1
VISITOR_STATS_MINUTES=15
